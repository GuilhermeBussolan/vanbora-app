{
  "expo": {
    "name": "VanBora",
    "slug": "vanbora",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vanbora",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F5C518",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5C518"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O VanBora usa sua localização para mostrar a van em tempo real no mapa."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
