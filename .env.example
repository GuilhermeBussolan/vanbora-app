# Variáveis de ambiente do app VanBora (Expo).
#
# Copie para `.env.local` (ignorado pelo git) e preencha.
#
# ATENÇÃO: no Expo, tudo que começa com EXPO_PUBLIC_ é embutido no bundle
# JavaScript enviado ao aparelho. Qualquer pessoa com o APK/IPA consegue ler
# esses valores. Só coloque aqui o que já é público por natureza (URL da API,
# domínio e client id do Auth0). Segredo — client secret, chave de gateway,
# token de serviço — vive apenas no backend.

# URL da API. Em aparelho físico use o IP da máquina na rede local
# (ex.: http://192.168.68.104:8080); no emulador Android, http://10.0.2.2:8080.
# Se não for definida, o app tenta descobrir o IP a partir do host do Metro.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_PORT=8080

# ------------------------------------------------- Login social (Auth0) -----
# Ambos são valores públicos de uma aplicação nativa (fluxo PKCE).
# Deixe em branco para esconder os botões "Entrar com Google/Facebook".
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
